#!/usr/bin/env python3
"""syndctl — command-line backend for the Synology Drive Omarchy plugin.

Reads the state the Synology Drive Client already keeps on disk — its SQLite
databases and daemon log under ~/.SynologyDrive — and drives the running
client through its own single-instance command channel (`synology-drive
pause|resume|show`). It never talks to the NAS and never writes to the
client's files.

Usage:
  syndctl get [--json]              connection, sync folders, activity, state
  syndctl log [-n N] [--json]       sync history, newest first (the client's Logs page)
  syndctl unsynced [--json]         files the client refused to sync
  syndctl settings [--json]         the client's options, read-only
  syndctl pause [<session-id>...]   pause syncing (all tasks, or the given ones)
  syndctl resume [<session-id>...]  resume syncing
  syndctl show                      raise the client's own window
  syndctl open [<session-id>]       open a sync folder in the file manager
  syndctl reveal <path>             select a file in the file manager
  syndctl ipc <action> [k=v ...]    raw request to the daemon (research; see PROTOCOL.md)
  syndctl doctor                    check every link from the client to the bar

pause/resume speak to the sync daemon directly over its local socket, with
the same request the client's own Pause button sends — not the launcher's
`synology-drive pause` verb, which rewrites a task setting instead.
"""

import argparse
import fcntl
import glob
import json
import contextlib
import os
import types
import shutil
import re
import signal
import socket
import sqlite3
import struct
import sys
import time
import stat

PLUGIN_ID = "dansmith888.synology-drive"
REPO_URL = "https://github.com/DanSmith888/omarchy-synology-drive.git"
REQUIRED_FILES = ("manifest.json", "BarWidget.qml", "Panel.qml",
                  "bin/syndstatus", "bin/syndctl")

# Never /tmp: a predictable shared path could be pre-created by another user.
_RUNTIME_DIR = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
# Our own 0700 directory inside the runtime dir, rather than a predictable
# name sitting directly in a shared one. The lock is opened O_NOFOLLOW and
# never truncated, so a symlink planted at the path is refused rather than
# followed and its target clobbered.
_TOOL = "syndctl"
_STATE_DIR = os.path.join(_RUNTIME_DIR, "dansmith888.synology-drive")
LOCK_PATH = os.path.join(_STATE_DIR, "lock")

def state_dirfd():
    """An O_DIRECTORY descriptor for our private runtime directory.

    The directory is validated on the descriptor itself (fstat: owned by us,
    0700), and the lock is then opened *relative to that descriptor*, so
    replacing a parent between validation and open cannot redirect it.
    """
    try:
        os.makedirs(_STATE_DIR, mode=0o700, exist_ok=True)
    except OSError as exc:
        raise SystemExit(f"{_TOOL}: cannot create {_STATE_DIR}: {exc}")
    try:
        fd = os.open(_STATE_DIR, os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    except OSError as exc:
        raise SystemExit(f"{_TOOL}: cannot open {_STATE_DIR}: {exc}")
    st = os.fstat(fd)
    if st.st_uid != os.getuid():
        os.close(fd)
        raise SystemExit(f"{_TOOL}: {_STATE_DIR} is not owned by this user")
    if st.st_mode & 0o077:
        os.fchmod(fd, 0o700)
    return fd


LOCK_TIMEOUT = 8.0
TIMEOUT = 10
SELF_DEADLINE = 25          # SIGALRM: no invocation may outlive this

sys.dont_write_bytecode = True
_HERE = os.path.dirname(os.path.abspath(__file__))


def _runtime():
    """Execute bin/plugin_runtime.py from bytes read through a validated
    no-follow descriptor.

    SourceFileLoader could satisfy the import from a matching
    __pycache__/*.pyc, executing bytecode nobody reviewed instead of the
    source next to it. Reading the exact bytes and compiling them leaves no
    bytecode path at all; a __pycache__ next to us is stale build litter and
    is removed so it cannot shadow anything else either.
    """
    shutil.rmtree(os.path.join(_HERE, "__pycache__"), ignore_errors=True)
    path = os.path.join(_HERE, "plugin_runtime.py")
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    except OSError as exc:
        raise SystemExit(f"syndctl: cannot open {path}: {exc}")
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid() \
                or st.st_size > 1_000_000:
            raise SystemExit(f"syndctl: {path} failed validation")
        with os.fdopen(fd, "rb") as handle:
            source = handle.read(st.st_size)
    except OSError as exc:
        raise SystemExit(f"syndctl: cannot read {path}: {exc}")
    mod = types.ModuleType("plugin_runtime")
    mod.__file__ = path
    sys.modules["plugin_runtime"] = mod
    exec(compile(source, path, "exec"), mod.__dict__)
    return mod


rt = _runtime()

DRIVE_DIR = os.path.expanduser("~/.SynologyDrive")
# Every Synology-controlled path (client.conf can redirect db/log/socket
# paths) is accepted only after resolving inside this root; anything else
# falls back to the default location. The client's files are readable by
# design; the bound stops a rewritten client.conf from pointing this tool at
# arbitrary files, FIFOs or symlink targets outside the client's own tree.
DRIVE_ROOT = os.path.realpath(DRIVE_DIR)
CLIENT_CONF = os.path.join(DRIVE_DIR, "data", "config", "client.conf")
LAUNCHER = "synology-drive"
# The peer we expect on the daemon socket; also matched by _proc_running.
DAEMON_PROCESS = "cloud-drive-daemon"

MAX_TEXT_BYTES = 256 * 1024      # any single confined text read
MAX_DB_BYTES = 1 << 30           # sanity ceiling on a database file
MAX_IPC_REPLY = 64 * 1024        # daemon replies are ~tens of bytes
MAX_IPC_OBJECTS = 16
MAX_PS_DEPTH = 16
MAX_PS_ITEMS = 4096
MAX_RUN_OUTPUT = 64 * 1024
MAX_ROWS = 64                    # producer cardinality cap per table read
_FIELD = 2048                    # per-string cap before the shell model


def _s(value, cap=_FIELD):
    """Truncate any producer-supplied string before it enters the model."""
    return None if value is None else str(value)[:cap]


def confined(path, fallback):
    """`path` resolved inside DRIVE_ROOT, else the (in-root) fallback."""
    if path:
        real = os.path.realpath(path)
        try:
            if os.path.commonpath([real, DRIVE_ROOT]) == DRIVE_ROOT:
                return real
        except ValueError:
            pass
    return os.path.realpath(fallback)


def walk_confined(path):
    """(dir_fd, leaf) for a confined path, walked one component at a time.

    confined() resolves a name and hands back a string; reopening that string
    later is a different operation on a possibly different file. O_NOFOLLOW
    guards only the final component, so swapping a *parent* directory for a
    symlink after the check redirects the open and nothing raises.

    That matters here because DRIVE_ROOT is not ordinary local storage: its
    contents arrive from the NAS, so directory entries under it are
    attacker-influenced input rather than something only we create.

    Descriptors bind to inodes, not names, so each component is opened
    relative to the descriptor of its validated parent and re-pointing a name
    mid-walk cannot redirect the walk. The caller closes dir_fd.
    """
    rel = os.path.relpath(path, DRIVE_ROOT)
    if rel == os.pardir or rel.startswith(os.pardir + os.sep):
        raise OSError(f"{path} is outside {DRIVE_ROOT}")
    parts = [p for p in rel.split(os.sep) if p not in ("", os.curdir)]
    if not parts:
        raise OSError(f"{path} is the root itself, not a file in it")

    # The anchor is opened by name: it is the trust root, and is realpath'd
    # once at import. Everything below it is descriptor-relative.
    dir_fd = os.open(DRIVE_ROOT, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    try:
        if os.fstat(dir_fd).st_uid != os.getuid():
            raise OSError(f"{DRIVE_ROOT} is not owned by this user")
        for part in parts[:-1]:
            nxt = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
                          | os.O_CLOEXEC, dir_fd=dir_fd)
            os.close(dir_fd)
            dir_fd = nxt
            if os.fstat(dir_fd).st_uid != os.getuid():
                raise OSError(f"{part} is not owned by this user")
        return dir_fd, parts[-1]
    except Exception:
        os.close(dir_fd)
        raise


def open_confined(path):
    """O_NOFOLLOW descriptor for a regular file we own, already confined.

    The parent chain is traversed on descriptors, so only the inode that was
    validated can be opened.
    """
    dir_fd, leaf = walk_confined(path)
    try:
        fd = os.open(leaf, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC,
                     dir_fd=dir_fd)
    finally:
        os.close(dir_fd)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            raise OSError(f"{path} is not a regular file")
        if st.st_uid != os.getuid():
            raise OSError(f"{path} is not owned by this user")
    except Exception:
        os.close(fd)
        raise
    return fd


def read_confined(path, cap=MAX_TEXT_BYTES):
    """At most `cap` bytes of a confined regular file, b"" on any failure."""
    try:
        fd = open_confined(path)
    except OSError:
        return b""
    try:
        chunks, total = [], 0
        while total <= cap:
            chunk = os.read(fd, min(65536, cap + 1 - total))
            if not chunk:
                break
            chunks.append(chunk)
            total += len(chunk)
        return b"".join(chunks)[:cap]
    finally:
        os.close(fd)

# How much of the daemon log one poll reads. The log rotates at 5 MB and is
# dominated by rescan chatter; 1 MB is ~13k lines, minutes to hours of
# activity, and parses in a few milliseconds.
LOG_TAIL_BYTES = 1_000_000

# history_table.action codes, mapped from observed rows (the binary keeps no
# names for them). Anything else is shown as "changed".
HISTORY_ACTION = {
    40: "downloaded",   # server -> local add/update
    24: "uploaded",     # local change pushed to the NAS
    18: "deleted",      # local deletion propagated to the NAS
    34: "skipped",      # file excluded by the client's filter
    17: "skipped",      # directory excluded by the client's filter
}

# history_table.not_synced_reason. -8192 is the only code seen so far and it
# lines up exactly with the blacklist filter (dot-files, *.tmp, *.crdownload
# style temporaries), so it is "excluded", not an error.
UNSYNCED_REASON = {
    -8192: "excluded by filter",
}
FILTERED_REASONS = {-8192}


def _run(cmd, timeout=TIMEOUT, env=None):
    """(rc, stdout, stderr); rc non-zero on timeout or a missing binary.

    Delegates to plugin_runtime, which drains both pipes concurrently against
    a byte ceiling enforced *while* reading, and enforces the deadline during
    the read. communicate() was not enough: it reads to EOF before the timeout
    applies, so MAX_RUN_OUTPUT only trimmed output that had already been
    allocated in full. Overflow or timeout kills the child's whole process
    group, so helpers spawned in turn do not outlive the call.

    cmd[0] is a bare program name, resolved against root-owned system
    directories rather than PATH; see plugin_runtime.open_trusted_exec.
    """
    return rt.run_bounded(cmd, timeout=timeout,
                          max_output=MAX_RUN_OUTPUT, env=env)


# ---------------------------------------------------------------------------
# Where the client keeps things

def read_conf():
    """client.conf as a dict. Empty when the client is not installed.

    Read bounded and without following symlinks; the path values inside are
    only ever used after `confined()` maps them back under DRIVE_ROOT.
    """
    conf = {}
    for line in read_confined(CLIENT_CONF).decode("utf-8", "replace").splitlines():
        if "=" in line:
            k, v = line.split("=", 1)
            conf[k.strip()[:128]] = v.strip().strip('"')[:1024]
    return conf


def installed():
    return os.path.isfile(CLIENT_CONF)


def _proc_running(needle):
    """PID of the first process whose cmdline contains `needle`, else None.

    A /proc scan rather than pgrep: no subprocess, and it works the same
    inside the shell's Process as from a terminal.
    """
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        try:
            with open(f"/proc/{pid}/cmdline", "rb") as f:
                cmd = f.read().replace(b"\0", b" ")
        except OSError:
            continue
        if needle.encode() in cmd:
            return int(pid)
    return None


def daemon_pid(conf):
    """PID from the daemon's pid file if that process is still the daemon."""
    pid_file = confined(conf.get("pid_file_path"), os.path.join(DRIVE_DIR, "daemon.pid"))
    try:
        pid = int(read_confined(pid_file, 64).decode("ascii", "replace").strip() or 0)
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            if b"cloud-drive-daemon" in f.read(4096):
                return pid
    except (OSError, ValueError):
        pass
    return _proc_running("cloud-drive-daemon")


def tray_status(ui_pid):
    """The client's own status line from its tray item's tooltip, e.g.
    'Up-to-date', 'Paused', 'Syncing 3 files' — or None. Read over D-Bus with
    busctl (systemd), the one non-stdlib helper we allow ourselves because it
    is always present on Omarchy. A cross-check, never the source of truth."""
    if not ui_pid or not rt.have_trusted("busctl"):
        return None
    rc, out, _ = _run(["busctl", "--user", "get-property",
                       f"org.kde.StatusNotifierItem-{ui_pid}-1", "/StatusNotifierItem",
                       "org.kde.StatusNotifierItem", "ToolTip"], timeout=2)
    if rc != 0:
        return None
    # (sa(iiay)ss) "" 0 "Synology Drive Client 4.0.3\nUp-to-date" ""
    parts = re.findall(r'"((?:[^"\\]|\\.)*)"', out)
    if len(parts) < 2:
        return None
    text = parts[1].encode().decode("unicode_escape", "ignore")
    lines = [l.strip()[:128] for l in text.split("\n") if l.strip()]
    return lines[-1] if len(lines) > 1 else (lines[0] if lines else None)


def client_version():
    """'4.0.3-17892' from the app bundle's INFO file, else None."""
    parts = {}
    text = read_confined(os.path.join(DRIVE_DIR, "SynologyDrive.app", "INFO"), 65536)
    for line in text.decode("utf-8", "replace").splitlines():
        if "=" in line:
            k, v = line.split("=", 1)
            parts[k.strip()] = v.strip().strip('"')[:64]
    try:
        ver = ".".join(parts[k] for k in ("major_version", "minor_version", "mini_version"))
    except KeyError:
        return None
    return f"{ver}-{parts['build_version']}" if parts.get("build_version") else ver


# ---------------------------------------------------------------------------
# SQLite: connection + sync folders (sys.sqlite), history (history.sqlite)

class _BoundConnection:
    """A sqlite3 connection that owns the validated directory descriptor.

    SQLite opens WAL/SHM sidecars lazily during later queries through the
    /proc/self/fd/<dir_fd>/ path it was given, so the descriptor must stay
    alive exactly as long as the connection: it is closed with it, and by
    the destructor as a backstop.
    """

    def __init__(self, con, dir_fd):
        object.__setattr__(self, "_con", con)
        object.__setattr__(self, "_dir_fd", dir_fd)

    def __getattr__(self, name):
        return getattr(object.__getattribute__(self, "_con"), name)

    def close(self):
        try:
            object.__getattribute__(self, "_con").close()
        finally:
            fd = object.__getattribute__(self, "_dir_fd")
            if fd is not None:
                object.__setattr__(self, "_dir_fd", None)
                with contextlib.suppress(OSError):
                    os.close(fd)

    def __del__(self):
        with contextlib.suppress(Exception):
            self.close()


def _db(path):
    """Read-only connection to a confined, validated database, or None.

    SQLite cannot be handed a descriptor: in WAL mode it derives -wal and -shm
    sidecars from the pathname and needs the containing directory, so a
    descriptor-only open is not possible for a live database.

    So the parent chain is walked on descriptors (walk_confined) and sqlite is
    pointed at that held directory through /proc/self/fd. The directory
    descriptor is owned by the returned connection and lives as long as it
    does, so a sidecar opened lazily mid-query still resolves through the
    validated object. Only the final component is opened by name, so its
    (dev, inode) is re-checked against the descriptor we inspected:
    prevention for the parents, detection for the leaf.
    """
    if not path:
        return None
    try:
        dir_fd, leaf = walk_confined(path)
    except OSError:
        return None
    try:
        fd = os.open(leaf, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC,
                     dir_fd=dir_fd)
    except OSError:
        os.close(dir_fd)
        return None
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid():
            os.close(dir_fd)
            return None
        if st.st_size > MAX_DB_BYTES:
            os.close(dir_fd)
            return None
        bound = os.path.join(f"/proc/self/fd/{dir_fd}", leaf)
        try:
            con = sqlite3.connect(f"file:{bound}?mode=ro", uri=True, timeout=1.0)
        except sqlite3.Error:
            os.close(dir_fd)
            return None
        try:
            now = os.stat(bound)
            if (now.st_dev, now.st_ino) != (st.st_dev, st.st_ino):
                raise OSError("leaf changed under us")
        except OSError:
            con.close()
            os.close(dir_fd)
            return None
        con.row_factory = sqlite3.Row
        con.execute("PRAGMA query_only = 1")
        return _BoundConnection(con, dir_fd)
    finally:
        os.close(fd)


def _sys_db(conf):
    base = confined(conf.get("db_path"), os.path.join(DRIVE_DIR, "data", "db"))
    return _db(confined(os.path.join(base, "sys.sqlite"), os.path.join(DRIVE_DIR, "data", "db", "sys.sqlite")))


def _history_db(conf):
    return _db(confined(conf.get("history_db_path"),
                        os.path.join(DRIVE_DIR, "data", "db", "history.sqlite")))


def connection(conf):
    """The linked NAS, or None when the client has never been linked."""
    con = _sys_db(conf)
    if con is None:
        return None
    try:
        row = con.execute(
            "select id, server_name, server_ip, server_port, username, "
            "computer_name, use_ssl, linked, status, error, host_name, "
            "conn_type, major, minor, package_version "
            "from connection_table order by linked desc, id limit 1").fetchone()
    except sqlite3.Error:
        return None
    finally:
        con.close()
    if row is None:
        return None
    server = _s(row["server_name"], 256) or _s(row["server_ip"], 64) or ""
    host = _s(row["host_name"], 128) or server.split(".")[0]
    return {
        "id": row["id"],
        "server": server,
        "host": host,
        "ip": row["server_ip"] or None,
        "port": row["server_port"],
        "user": _s(row["username"], 128),
        "computer": _s(row["computer_name"], 128),
        "ssl": bool(row["use_ssl"]),
        "linked": bool(row["linked"]),
        "status": row["status"],
        "error": row["error"],
        "server_version": (f"{row['major']}.{row['minor']}"
                           if row["major"] else None),
    }


def sessions(conf):
    """Sync folders ("sessions" in Synology's terms), oldest first."""
    con = _sys_db(conf)
    if con is None:
        return []
    try:
        rows = con.execute(
            "select id, conn_id, share_name, remote_path, sync_folder, status, "
            "error, sync_direction, is_read_only, is_daemon_enable, "
            "session_type, custom_session_name, is_shared_with_me "
            "from session_table order by id limit ?", (MAX_ROWS,)).fetchall()
    except sqlite3.Error:
        return []
    finally:
        con.close()
    out = []
    for r in rows:
        folder = _s((r["sync_folder"] or "").rstrip("/"), 1024)
        out.append({
            "id": r["id"],
            "name": _s(r["custom_session_name"] or r["share_name"] or os.path.basename(folder), 128),
            "share": _s(r["share_name"], 128),
            "remote": _s(r["remote_path"], 512) or "/",
            "folder": folder,
            "status": r["status"],
            "error": r["error"],
            # 0 = two-way, 1 = download only, 2 = upload only (client UI order)
            "direction": r["sync_direction"],
            "read_only": bool(r["is_read_only"]),
            "enabled": bool(r["is_daemon_enable"]),
            "type": r["session_type"],
            "shared_with_me": bool(r["is_shared_with_me"]),
        })
    return out


def _history_row(r):
    action = HISTORY_ACTION.get(r["action"], "changed")
    path = _s(r["path"], 2048) or ""
    return {
        "exists": bool(path) and os.path.lexists(path),
        "id": r["id"],
        "session": r["session_id"],
        "action": action,
        "action_code": r["action"],
        "time": r["update_time"],
        "is_dir": bool(r["is_dir"]),
        "name": _s(r["name"], 256),
        "path": path,
        "folder": _s((r["sync_folder"] or "").rstrip("/"), 1024),
    }


def recent(conf, limit=8, offset=0):
    """Most recent completed transfers, newest first. Skipped files are left
    out: they are what `unsynced` is for."""
    con = _history_db(conf)
    if con is None:
        return []
    try:
        rows = con.execute(
            "select id, session_id, action, update_time, is_dir, name, path, "
            "sync_folder from history_table where is_not_synced = 0 "
            "order by id desc limit ? offset ?", (limit, offset)).fetchall()
    except sqlite3.Error:
        return []
    finally:
        con.close()
    return [_history_row(r) for r in rows]


def unsynced(conf, limit=8):
    """(problems, skipped_count): files the client would not sync.

    Entries excluded by the client's own filter (temporaries, dot-files) are
    only counted; the rest — the ones the Synology tray raises alerts for —
    come back as rows, newest first, one per path.
    """
    con = _history_db(conf)
    if con is None:
        return [], 0
    try:
        skipped = con.execute(
            "select count(distinct path) from history_table "
            "where is_not_synced = 1 and not_synced_reason in (%s)"
            % ",".join(str(x) for x in FILTERED_REASONS)).fetchone()[0]
        rows = con.execute(
            "select max(id) id, session_id, action, max(update_time) update_time, "
            "is_dir, name, path, sync_folder, not_synced_reason "
            "from history_table where is_not_synced = 1 "
            "and not_synced_reason not in (%s) "
            "group by path order by id desc limit ?"
            % ",".join(str(x) for x in FILTERED_REASONS), (limit,)).fetchall()
    except sqlite3.Error:
        return [], 0
    finally:
        con.close()
    out = []
    for r in rows:
        d = _history_row(r)
        code = r["not_synced_reason"]
        d["reason_code"] = code
        d["reason"] = UNSYNCED_REASON.get(code, f"not synced (code {code})")
        out.append(d)
    return out, skipped


def _filter_file(path):
    """A Synology .filter file (INI-ish) as {section: {key: [values]}}.

    Confined bounded read; sections, keys and values are capped before they
    reach the model.
    """
    out, section = {}, None
    text = read_confined(confined(path, path if str(path).startswith(DRIVE_ROOT) else DRIVE_ROOT), 65536)
    if not text:
        return None
    for raw in text.decode("utf-8", "replace").splitlines():
        line = raw.strip()
        if not line:
            continue
        if line.startswith("[") and line.endswith("]"):
            if len(out) >= 16:
                break
            section = line[1:-1][:64]
            out.setdefault(section, {})
        elif "=" in line and section is not None:
            k, v = line.split("=", 1)
            vals = [x.strip().strip('"')[:128] for x in v.split(",")[:32]]
            out[section][k.strip()[:64]] = [x for x in vals if x != ""]
    return out


def settings(conf):
    """What the client's own Settings pages show, read-only.

    Global flags come from system_table, per-task options from session_table
    and the task's filter files. Nothing here can be written back: the only
    supported way to change them is the client's own window (`syndctl show`).
    """
    con = _sys_db(conf)
    glob = {}
    if con is not None:
        try:
            glob = {_s(r["key"], 64): _s(r["value"], 256)
                    for r in con.execute("select key, value from system_table limit 128")}
        except sqlite3.Error:
            glob = {}
        finally:
            con.close()

    def flag(k):
        v = glob.get(k)
        return None if v is None else v not in ("0", "", "false")

    tasks = []
    for s in sessions(conf):
        sdir = os.path.join(DRIVE_DIR, "data", "session", str(s["id"]), "conf")
        black = _filter_file(os.path.join(sdir, "blacklist.filter")) or {}
        common, files = black.get("Common", {}), black.get("File", {})
        tasks.append({
            "id": s["id"], "name": s["name"], "folder": s["folder"], "remote": s["remote"],
            "direction": {0: "two-way", 1: "download only", 2: "upload only"}.get(s["direction"], str(s["direction"])),
            "read_only": s["read_only"],
            "enabled": s["enabled"],
            "filters": {
                "excluded_extensions": files.get("black_ext", []),
                "excluded_name_prefixes": common.get("black_prefix", []),
                "excluded_folders": common.get("black_dir_prefix", []),
                "max_file_size": int(files.get("max_size", ["0"])[0] or 0) or None,
            },
        })

    return {
        "global": {
            "start_at_login": flag("enable_startup"),
            "desktop_notifications": flag("enable_desktop_notification"),
            "unsynced_notifications": flag("enable_unsynced_notification"),
            "icon_overlay": flag("enable_iconoverlay"),
            "context_menu": flag("enable_context_menu"),
            "black_white_tray_icon": flag("use_black_white_icon"),
            "sync_temp_files": flag("sync_temp_file"),
            "advanced_log": flag("enable_advanced_log"),
            "sync_mode": glob.get("sync_mode"),
            "proxy": flag("user_use_proxy"),
            "computer_name": glob.get("computer_name"),
        },
        "tasks": tasks,
    }


# ---------------------------------------------------------------------------
# Daemon IPC: bare PStream objects over ~/.SynologyDrive/daemon.sock
#
# PStream is Synology's own serialisation (the NAS protocol uses it too):
#   null    00 00              integer 01 <size 1|2|4|8> <big-endian>
#   string  10 <u16be len> …   array   41 … 40        map  42 (str value)* 40
# The local socket carries one bare object per request, no length prefix; the
# daemon answers with a map that always carries "ack": "ok" (it acks before
# it parses — an unknown action is still acked, and logged as
# "<<< Unknown IPC action"). Details and the observed vocabulary: PROTOCOL.md.

_PS_NULL, _PS_INT, _PS_STR, _PS_BIN, _PS_END, _PS_ARR, _PS_MAP = 0x00, 0x01, 0x10, 0x30, 0x40, 0x41, 0x42
IPC_TIMEOUT = 3.0


def ps_encode(obj, buf=None):
    b = bytearray() if buf is None else buf
    if obj is None:
        b += b"\x00\x00"
    elif isinstance(obj, bool):
        ps_encode(int(obj), b)
    elif isinstance(obj, int):
        b.append(_PS_INT)
        if obj < 0x100:
            b += bytes([1, obj])
        elif obj < 0x10000:
            b += b"\x02" + struct.pack(">H", obj)
        elif obj < 0x1_0000_0000:
            b += b"\x04" + struct.pack(">I", obj)
        else:
            b += b"\x08" + struct.pack(">Q", obj)
    elif isinstance(obj, str):
        raw = obj.encode()
        b.append(_PS_STR)
        b += struct.pack(">H", len(raw)) + raw
    elif isinstance(obj, (list, tuple)):
        b.append(_PS_ARR)
        for item in obj:
            ps_encode(item, b)
        b.append(_PS_END)
    elif isinstance(obj, dict):
        b.append(_PS_MAP)
        for k, v in obj.items():
            ps_encode(str(k), b)
            ps_encode(v, b)
        b.append(_PS_END)
    else:
        raise TypeError(f"PStream cannot encode {type(obj).__name__}")
    return bytes(b)


def ps_decode(buf, i=0, depth=0):
    """(object, next_index). Raises ValueError on an unknown tag, on nesting
    deeper than MAX_PS_DEPTH, or on a container larger than MAX_PS_ITEMS —
    the replies this tool asks for are single flat maps of a few keys."""
    if depth > MAX_PS_DEPTH:
        raise ValueError("PStream: nesting too deep")
    tag = buf[i]
    if tag == _PS_NULL:
        return None, i + 2
    if tag == _PS_INT:
        n = buf[i + 1]
        return int.from_bytes(buf[i + 2:i + 2 + n], "big"), i + 2 + n
    if tag == _PS_STR:
        n = struct.unpack(">H", buf[i + 1:i + 3])[0]
        return buf[i + 3:i + 3 + n].decode("utf-8", "replace"), i + 3 + n
    if tag == _PS_BIN:
        n = struct.unpack(">I", buf[i + 1:i + 5])[0]
        if n > len(buf):
            raise ValueError("PStream: binary length exceeds buffer")
        return buf[i + 5:i + 5 + n], i + 5 + n
    if tag == _PS_ARR:
        i += 1
        out = []
        while buf[i] != _PS_END:
            if len(out) >= MAX_PS_ITEMS:
                raise ValueError("PStream: array too large")
            v, i = ps_decode(buf, i, depth + 1)
            out.append(v)
        return out, i + 1
    if tag == _PS_MAP:
        i += 1
        out = {}
        while buf[i] != _PS_END:
            if len(out) >= MAX_PS_ITEMS:
                raise ValueError("PStream: map too large")
            k, i = ps_decode(buf, i, depth + 1)
            v, i = ps_decode(buf, i, depth + 1)
            out[k] = v
        return out, i + 1
    raise ValueError(f"PStream: unknown tag 0x{tag:02x} at offset {i}")


def _daemon_exe_paths():
    """Absolute paths the real daemon may run from. The vendor installs the
    live binary under the user's home (SynologyDrive.app), so root ownership
    cannot be required of it; identity comes from the exact path plus the
    kernel-reported pid matching the pid-file-validated daemon."""
    return (
        os.path.join(DRIVE_ROOT, "SynologyDrive.app", "bin", "cloud-drive-daemon"),
        "/opt/Synology/SynologyDrive/package/cloudstation/bin/cloud-drive-daemon",
    )


def _peer_is_daemon(sock, expected_pid):
    """True only when the connected peer is the validated daemon. Fail closed.

    SO_PEERCRED is recorded by the kernel at connect time and cannot be
    forged. Three bindings, all required: the peer uid is ours, the peer pid
    is exactly the daemon pid we validated out of the pid file (a same-user
    process merely *named* cloud-drive-daemon serving a planted socket has a
    different pid), and /proc/<pid>/exe resolves to one of the daemon's
    known absolute locations. Any error reads as "not the daemon".
    """
    if not expected_pid:
        return False
    try:
        raw = sock.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED,
                              struct.calcsize("3i"))
        pid, uid, _gid = struct.unpack("3i", raw)
    except (OSError, struct.error):
        return False
    if uid != os.getuid() or pid != expected_pid:
        return False
    try:
        exe = os.readlink(f"/proc/{pid}/exe")
    except OSError:
        return False
    return exe in _daemon_exe_paths()


def daemon_call(conf, request, timeout=IPC_TIMEOUT):
    """Send one request map to the daemon, return the list of reply objects.

    None when the socket is absent or refuses (daemon not running).

    Trust comes from the connected peer, not from the path. lstat'ing a name
    and then connecting to it checks one object and uses another: the entry
    can be replaced in between, and the reply is then parsed as if the daemon
    had sent it. So the parent chain is walked on descriptors, the connect
    goes through /proc/self/fd to that held directory, and the peer is
    authenticated with SO_PEERCRED once connected.

    The reply is capped at MAX_IPC_REPLY bytes and MAX_IPC_OBJECTS objects.
    """
    expected_pid = daemon_pid(conf)
    if not expected_pid:
        return None
    path = confined(conf.get("socket_path"), os.path.join(DRIVE_DIR, "daemon.sock"))
    try:
        dir_fd, leaf = walk_confined(path)
    except OSError:
        return None
    data = b""
    try:
        try:
            st = os.lstat(leaf, dir_fd=dir_fd)
            if not stat.S_ISSOCK(st.st_mode) or st.st_uid != os.getuid():
                return None
        except OSError:
            return None
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sock.settimeout(timeout)
        try:
            sock.connect(os.path.join(f"/proc/self/fd/{dir_fd}", leaf))
            if not _peer_is_daemon(sock, expected_pid):
                return None
            sock.sendall(ps_encode(request))
            deadline = time.monotonic() + timeout
            while time.monotonic() < deadline and len(data) <= MAX_IPC_REPLY:
                try:
                    chunk = sock.recv(65536)
                except socket.timeout:
                    break
                if not chunk:
                    break
                data += chunk
        except OSError:
            return None
        finally:
            sock.close()
    finally:
        os.close(dir_fd)
    if len(data) > MAX_IPC_REPLY:
        return None
    out, i = [], 0
    try:
        while i < len(data) and len(out) < MAX_IPC_OBJECTS:
            obj, i = ps_decode(data, i)
            out.append(obj)
    except (ValueError, IndexError, struct.error):
        out.append({"_undecoded": data[i:i + 256].hex()})
    return out


def daemon_ok(reply):
    return bool(reply) and isinstance(reply[0], dict) and reply[0].get("ack") == "ok"


def event_count(conf, session_id):
    """Pending event count for one session straight from the daemon, or None."""
    r = daemon_call(conf, {"action": "get_event_count", "session_id": int(session_id)}, timeout=0.8)
    if daemon_ok(r) and isinstance(r[0].get("event_count"), int):
        return r[0]["event_count"]
    return None


# ---------------------------------------------------------------------------
# Daemon log: the only place live activity shows up

_PREFIX_RE = re.compile(
    r"^(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d) \(\s*(\d+):\s*\d+\) \[(\w+)\] "
    r"([\w.-]+)\(\d+\): (.*)$")
_EVENT_RE = re.compile(
    r"Event<(\w+)>\[(\d+)\]\{source: (\w+), type: (\w+), file_id: '[^']*', "
    r"parent_id: '[^']*', path: '(.*?)', sync_id: \d+, max_id: \d+, "
    r"file_size: (\d+)")
_POOL_EMPTY_RE = re.compile(
    r"Syncer event pool is now empty.*session id (\d+)")
_SET_SYNC_ID_RE = re.compile(r"Set session (\d+)'s sync_id to")
# "by session id" when a task was selected in the client, "by connection id"
# when the NAS entry was; the daemon does the same thing either way.
_PAUSE_SESSION_RE = re.compile(r"^(Pause|Resume) session (\d+) by (?:session|connection) id")

_EVENT_KIND = {
    "add": "added", "modify": "modified", "remove": "removed",
    "delete": "removed", "rename": "renamed", "move": "moved",
}


def _log_path(conf):
    return confined(conf.get("log_file_path"), os.path.join(DRIVE_DIR, "log", "daemon.log"))


def _tail(path, nbytes):
    """The last `nbytes` of a confined regular file, without following a
    symlink and never reading more than asked."""
    try:
        fd = open_confined(path)
    except OSError:
        return b""
    try:
        size = os.lseek(fd, 0, os.SEEK_END)
        os.lseek(fd, max(0, size - nbytes), os.SEEK_SET)
        chunks, total = [], 0
        while total < nbytes:
            chunk = os.read(fd, min(65536, nbytes - total))
            if not chunk:
                break
            chunks.append(chunk)
            total += len(chunk)
        data = b"".join(chunks)
    finally:
        os.close(fd)
    if size > nbytes:
        data = data.split(b"\n", 1)[-1]      # drop the partial first line
    return data


def log_tail(conf):
    """The last LOG_TAIL_BYTES of the daemon log as text. When the live file
    is young (just rotated) the newest rotated file is prepended so the
    paused/offline markers survive a rotation."""
    path = _log_path(conf)
    data = _tail(path, LOG_TAIL_BYTES)
    if len(data) < LOG_TAIL_BYTES:
        def _mtime(p):
            try:
                st = os.lstat(p)
                return st.st_mtime if stat.S_ISREG(st.st_mode) else 0
            except OSError:
                return 0
        rotated = sorted(glob.glob(path + "_*")[:64], key=_mtime)
        if rotated:
            data = _tail(rotated[-1], LOG_TAIL_BYTES - len(data)) + data
    return data.decode("utf-8", "replace")


def _ts(text):
    try:
        return int(time.mktime(time.strptime(text, "%Y-%m-%dT%H:%M:%S")))
    except (ValueError, OverflowError):
        return None


def _event_kind(cls, ftype):
    name = cls.lower().replace("event", "")
    for k, v in _EVENT_KIND.items():
        if name.endswith(k):
            return v
    return "changed"


def parse_log(text):
    """Live state from the daemon's own narration.

    PushEvent queues a file, PullEvent hands it to a worker, DoneEvent
    finishes it, and "Syncer event pool is now empty" for a session means
    that folder is up to date. pause/resume and channel failures are the
    only markers for paused and offline. A daemon restart (new pid in the
    prefix) drops everything queued by the previous one.
    """
    pending = {}            # (session, path) -> item
    idle_at = {}            # session -> ts of last "pool empty"
    paused_sessions = {}    # session -> True while paused
    pause_ts = None
    last_fail = None        # ts of last "Failed to establish a new channel"
    last_ok = None          # ts of last sign the NAS answered
    last_activity = None    # ts of last Push/Done
    last_error = None
    last_pid = None
    last_ts = None

    for line in text.splitlines():
        # rescan chatter is 85% of the log and never interesting
        if "rescan-handler.cpp" in line:
            continue
        m = _PREFIX_RE.match(line)
        if not m:
            continue
        ts_text, pid, level, src, msg = m.groups()
        ts = _ts(ts_text)
        last_ts = ts
        if pid != last_pid:
            if last_pid is not None:
                pending.clear()
                paused_sessions.clear()
            last_pid = pid

        if src == "event-manager.cpp":
            e = _EVENT_RE.search(msg)
            if not e:
                continue
            cls, sess, source, ftype, path, size = e.groups()
            key = (int(sess), path)
            if msg.startswith("PushEvent"):
                pending[key] = {
                    "session": int(sess), "path": path,
                    "name": os.path.basename(path.rstrip("/")) or path,
                    "direction": "download" if source == "server" else "upload",
                    "kind": _event_kind(cls, ftype), "is_dir": ftype != "file",
                    "size": int(size), "since": ts, "started": False,
                }
                last_activity = ts
            elif msg.startswith("PullEvent"):
                item = pending.get(key)
                if item is None:
                    item = pending[key] = {
                        "session": int(sess), "path": path,
                        "name": os.path.basename(path.rstrip("/")) or path,
                        "direction": "download" if source == "server" else "upload",
                        "kind": _event_kind(cls, ftype), "is_dir": ftype != "file",
                        "size": int(size), "since": ts,
                    }
                item["started"] = True
                item["started_at"] = ts
            elif msg.startswith("DoneEvent"):
                pending.pop(key, None)
                last_activity = ts
                last_ok = ts
            continue

        if src == "syncer-event-manager.cpp":
            e = _POOL_EMPTY_RE.search(msg)
            if e:
                sess = int(e.group(1))
                idle_at[sess] = ts
                for key in [k for k in pending if k[0] == sess]:
                    del pending[key]
                last_ok = ts
            continue

        # The real pause markers. "WorkerManager: pause/resume all worker" is
        # barrier housekeeping that fires on every session reload as well, so
        # it is deliberately ignored. Pause is per session and not persisted
        # anywhere on disk; a daemon restart un-pauses (handled by the pid
        # reset above).
        if src == "daemon-impl.cpp":
            m2 = _PAUSE_SESSION_RE.search(msg)
            if m2:
                paused_sessions[int(m2.group(2))] = m2.group(1) == "Pause"
                pause_ts = ts
            continue

        if src == "pullevent-handler.cpp" and _SET_SYNC_ID_RE.search(msg):
            last_ok = ts
            continue

        if src == "protocol-client.cpp" and "Failed to establish a new channel" in msg:
            last_fail = ts
            continue

        if level == "ERROR":
            last_error = {"time": ts, "text": msg[:160]}

    offline = last_fail is not None and (last_ok is None or last_fail > last_ok)
    paused = any(paused_sessions.values())
    queue = sorted(pending.values(), key=lambda i: (not i.get("started"), i["since"] or 0))
    current = None
    started = [i for i in queue if i.get("started")]
    if started:
        current = max(started, key=lambda i: i.get("started_at") or 0)
    return {
        "queue": queue,
        "current": current,
        "paused": paused,
        "paused_sessions": sorted(k for k, v in paused_sessions.items() if v),
        "paused_since": pause_ts if paused else None,
        "offline": offline,
        "offline_since": last_fail if offline else None,
        "idle_at": idle_at,
        "last_activity": last_activity,
        "last_error": last_error,
        "log_last_ts": last_ts,
    }


# ---------------------------------------------------------------------------
# Putting it together

class Client:
    """Exclusive access to the client's files and command channel.

    Reads would be safe without it, but every syndctl/syndstatus invocation
    going through one lock keeps a pause/resume from racing a poll.
    """

    def __enter__(self):
        # The lock is opened relative to the validated directory descriptor
        # (never through the full path), O_RDWR|O_CREAT and never O_TRUNC:
        # the file's contents are irrelevant, and truncating or following
        # whatever else might sit at the path is the bug being avoided.
        dirfd = state_dirfd()
        try:
            fd = os.open("lock", os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC,
                         0o600, dir_fd=dirfd)
        finally:
            os.close(dirfd)
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            os.close(fd)
            raise SystemExit(f"syndctl: {LOCK_PATH} is not a regular file")
        self._lock = os.fdopen(fd, "r+")
        deadline = time.monotonic() + LOCK_TIMEOUT
        while True:
            try:
                fcntl.flock(self._lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() > deadline:
                    self._lock.close()
                    raise SystemExit(
                        f"syndctl: busy (waited {LOCK_TIMEOUT:.0f}s for {LOCK_PATH})")
                time.sleep(0.25)
        self.conf = read_conf()
        return self

    def __exit__(self, *_):
        try:
            fcntl.flock(self._lock, fcntl.LOCK_UN)
        finally:
            self._lock.close()

    # ---- read

    def get(self, recent_n=40, queue_n=8):
        conf = self.conf
        if not conf:
            return None
        conn = connection(conf)
        sess = sessions(conf)
        live = parse_log(log_tail(conf))
        problems, skipped = unsynced(conf, limit=6)
        dpid = daemon_pid(conf)
        upid = _proc_running("cloud-drive-ui")

        # Local events carry file_size 0 in the log; the file is right there.
        folders = {s["id"]: s["folder"] for s in sess}
        for item in live["queue"]:
            if item["direction"] == "upload" and not item["size"] and item["session"] in folders:
                try:
                    item["size"] = os.path.getsize(folders[item["session"]] + item["path"])
                except OSError:
                    pass

        by_session = {}
        for item in live["queue"]:
            by_session.setdefault(item["session"], []).append(item)
        for s in sess:
            q = by_session.get(s["id"], [])
            s["pending"] = len(q)
            # The daemon's own count: exact, and it survives log rotation.
            # Log-derived pending keeps the file names; this keeps it honest.
            s["event_count"] = event_count(conf, s["id"]) if dpid else None
            if s["event_count"] and not q:
                s["pending"] = s["event_count"]
            s["idle_since"] = live["idle_at"].get(s["id"])
            if not dpid:
                s["state"] = "stopped"
            elif s["error"]:
                s["state"] = "error"
            elif s["id"] in live["paused_sessions"]:
                s["state"] = "paused"
            elif live["offline"]:
                s["state"] = "offline"
            elif q:
                s["state"] = "syncing"
            else:
                s["state"] = "uptodate"

        if not dpid:
            state = "stopped"
        elif conn is None or not conn["linked"]:
            state = "unlinked"
        elif live["paused"]:
            state = "paused"
        elif conn["error"] or any(s["error"] for s in sess):
            state = "error"
        elif live["offline"]:
            state = "offline"
        elif live["queue"] or any(s["pending"] for s in sess):
            state = "syncing"
        else:
            state = "uptodate"

        try:
            log_age = int(time.time() - os.path.getmtime(_log_path(conf)))
        except OSError:
            log_age = None

        return {
            "installed": True,
            "version": client_version(),
            "daemon_running": bool(dpid),
            "ui_running": bool(upid),
            "tray_status": tray_status(upid),
            "state": state,
            "paused": live["paused"],
            "paused_sessions": live["paused_sessions"],
            "paused_since": live["paused_since"],
            "offline": live["offline"],
            "offline_since": live["offline_since"],
            "connection": conn,
            "sessions": sess,
            "pending": max(len(live["queue"]), sum(s["pending"] for s in sess)),
            "current": live["current"],
            "queue": live["queue"][:queue_n],
            "last_activity": live["last_activity"],
            "last_error": live["last_error"],
            "recent": recent(conf, limit=recent_n),
            "unsynced": problems,
            "unsynced_count": len(problems),
            "skipped_count": skipped,
            "log_age": log_age,
            "settings": settings(conf),
        }

    # ---- control

    def _client_env(self):
        env = dict(os.environ)
        # The client ships only the xcb platform plugin, so it must go via
        # XWayland. Hyprland exports DISPLAY; fall back to :0 for hotkeys
        # started from a bare environment.
        env.setdefault("DISPLAY", ":0")
        env["QT_QPA_PLATFORM"] = "xcb"
        return env

    def _send(self, verb, require_running=True):
        """Hand a verb to the running client via its single-instance socket.

        The launcher starts a throwaway UI process that forwards the word to
        the live instance and exits; nothing comes back on stdout. When no
        instance is running the launcher would start one instead, which is
        wanted for `show` and surprising for `pause`.
        """
        if not rt.have_trusted(LAUNCHER):
            raise SystemExit(f"syndctl: {LAUNCHER} not found in a trusted system directory; is synology-drive-client installed?")
        if require_running and not _proc_running("cloud-drive-ui"):
            raise SystemExit("syndctl: Synology Drive Client is not running (start it with: syndctl show)")
        rc, _, err = _run([LAUNCHER, verb], timeout=25, env=self._client_env())
        if rc != 0:
            err = "\n".join(l for l in err.splitlines()
                            if not l.startswith(("debug.message", "qt.qpa"))).strip()
            raise SystemExit(f"syndctl: {LAUNCHER} {verb} failed (rc {rc}){': ' + err if err else ''}")

    def _wait_marker(self, markers, since, timeout=4.0):
        """True once every marker appears in the daemon log at or after `since`."""
        path = _log_path(self.conf)
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline:
            seen = set()
            for line in _tail(path, 65536).decode("utf-8", "replace").splitlines()[::-1]:
                m = _PREFIX_RE.match(line)
                if not m:
                    continue
                ts = _ts(m.group(1))
                if ts is not None and ts < since - 1:
                    break                       # older than our request: stop scanning
                for mk in markers:
                    if mk in line:
                        seen.add(mk)
            if seen >= set(markers):
                return True
            time.sleep(0.25)
        return False

    def _session_ids(self, wanted):
        known = {s["id"]: s for s in sessions(self.conf)}
        if not wanted:
            return [i for i, s in known.items() if s["enabled"]]
        bad = [i for i in wanted if i not in known]
        if bad:
            raise SystemExit(f"syndctl: no such sync task: {', '.join(map(str, bad))} (have {', '.join(map(str, known))})")
        return list(wanted)

    def _pause_resume(self, verb, wanted):
        """`verb` is 'pause' or 'resume'. Same request the client's button sends:
        {"action": verb, "session_id_list": [ids]}. Confirmed by the daemon's
        per-session log line; pause is not persisted anywhere else."""
        if not daemon_pid(self.conf):
            raise SystemExit("syndctl: sync daemon is not running")
        ids = self._session_ids(wanted)
        since = int(time.time())
        reply = daemon_call(self.conf, {"action": verb, "session_id_list": ids})
        if reply is None:
            raise SystemExit("syndctl: daemon socket did not answer")
        if not daemon_ok(reply):
            raise SystemExit(f"syndctl: daemon rejected {verb}: {reply!r}")
        word = "Pause" if verb == "pause" else "Resume"
        confirmed = self._wait_marker([f"{word} session {i} by session id" for i in ids], since)
        return {"action": verb, "sessions": ids, "confirmed": confirmed}

    def pause(self, wanted=()):
        return self._pause_resume("pause", wanted)

    def resume(self, wanted=()):
        return self._pause_resume("resume", wanted)

    def ipc(self, action, fields):
        if not daemon_pid(self.conf):
            raise SystemExit("syndctl: sync daemon is not running")
        req = {"action": action}
        req.update(fields)
        reply = daemon_call(self.conf, req)
        if reply is None:
            raise SystemExit("syndctl: daemon socket did not answer")
        return reply

    def show(self):
        self._send("show", require_running=False)

    def reveal(self, path):
        """Select `path` in the file manager (Nautilus), else open its folder."""
        if not path or not os.path.lexists(path):
            raise SystemExit(f"syndctl: no such file: {path}")
        if rt.have_trusted("nautilus"):
            cmd = ["nautilus", "--select", path]
            if rt.have_trusted("uwsm-app"):
                cmd = ["uwsm-app", "--"] + cmd
        else:
            cmd = ["xdg-open", path if os.path.isdir(path) else os.path.dirname(path)]
        try:
            rt.spawn_trusted(cmd)
        except OSError as exc:
            raise SystemExit(f"syndctl: {exc}")
        return path

    def open(self, session_id=None):
        sess = sessions(self.conf)
        folder = None
        if session_id is not None:
            for s in sess:
                if s["id"] == session_id:
                    folder = s["folder"]
        elif sess:
            folder = sess[0]["folder"]
        if not folder or not os.path.isdir(folder):
            raise SystemExit(f"syndctl: no sync folder for session {session_id}")
        try:
            rt.spawn_trusted(["xdg-open", folder])
        except OSError as exc:
            raise SystemExit(f"syndctl: {exc}")
        return folder


# ---------------------------------------------------------------------------

def doctor():
    """Check every link from the client to the bar widget.

    An absent widget can have many causes that look identical from outside;
    this says which link is broken and how to fix it.
    """
    checks = []

    def add(ok, label, detail="", fix=""):
        checks.append((ok, label, detail, fix))

    # 1. the client
    add(installed(), "Synology Drive Client installed", CLIENT_CONF,
        "yay -S synology-drive-client-bin   # or synology-drive from the AUR")
    conf = read_conf()
    dpid = daemon_pid(conf) if conf else None
    upid = _proc_running("cloud-drive-ui")
    add(bool(dpid), "Sync daemon running",
        f"cloud-drive-daemon pid {dpid}" if dpid else "",
        f"QT_QPA_PLATFORM=xcb {LAUNCHER} start   # or log out and in")
    add(bool(upid), "Client UI running (tray + settings window)",
        f"cloud-drive-ui pid {upid}" if upid else "",
        f"QT_QPA_PLATFORM=xcb {LAUNCHER} start")
    _launcher_fd, _launcher_path = rt.open_trusted_exec(LAUNCHER)
    if _launcher_fd is not None:
        os.close(_launcher_fd)
    add(_launcher_path is not None,
        "synology-drive launcher in a trusted system directory",
        _launcher_path or "", "install the client package")

    # 2. its data
    conn = connection(conf) if conf else None
    add(conn is not None, "Client database readable",
        os.path.join(conf.get("db_path", ""), "sys.sqlite") if conf else "",
        "check ~/.SynologyDrive/data/db permissions")
    add(bool(conn and conn["linked"]), "Linked to a NAS",
        f"{conn['user']}@{conn['server']}:{conn['port']}" if conn else "",
        "link a NAS in the Synology Drive Client window: syndctl show")
    sess = sessions(conf) if conf else []
    add(bool(sess), "At least one sync folder",
        ", ".join(f"{s['name']} -> {s['folder']}" for s in sess),
        "add a sync task in the client window: syndctl show")
    log = _log_path(conf) if conf else ""
    try:
        age = int(time.time() - os.path.getmtime(log))
        log_ok, log_detail = True, f"{log} ({age}s old)"
    except OSError:
        log_ok, log_detail = False, log
    add(log_ok, "Daemon log readable", log_detail,
        "check ~/.SynologyDrive/log permissions")
    if dpid:
        r = daemon_call(conf, {"action": "get_event_count", "session_id": sess[0]["id"] if sess else 1}, timeout=1.5)
        add(daemon_ok(r), "Daemon IPC answers (pause/resume, event counts)",
            f"event_count={r[0].get('event_count')}" if daemon_ok(r) else repr(r),
            "restart the client: synology-drive quit; " + LAUNCHER + " start")
    if log_ok and upid:
        # Informational: the client's tray only reflects pauses it made itself,
        # so after a pause/resume from the bar it lags until its next own action.
        tray = tray_status(upid)
        live = parse_log(log_tail(conf))
        add(True, "Client tray says",
            f"{tray!r}; daemon log says {'paused' if live['paused'] else 'running'}"
            + ("" if tray is None or (("Paused" in tray) == live["paused"])
               else "  (the client's tray does not follow pauses made from the bar)"), "")
    if log_ok:
        live = parse_log(log_tail(conf))
        add(not live["offline"], "NAS reachable (per daemon log)",
            "" if not live["offline"] else "last channel failure newer than last success",
            "check the NAS / VPN / Tailscale link, then: syndctl show")
        if live["paused"]:
            add(True, "Sync paused by user", "syndctl resume to continue", "")

    # 3. plugin
    plug = os.path.expanduser("~/.config/omarchy/plugins/" + PLUGIN_ID)
    add(os.path.isdir(plug), "Plugin installed", plug,
        "omarchy plugin add " + REPO_URL + " --enable")
    missing = [f for f in REQUIRED_FILES if not os.path.exists(os.path.join(plug, f))]
    add(not missing, "Plugin files present",
        "missing: " + ", ".join(missing) if missing else "",
        "omarchy plugin update " + PLUGIN_ID)

    # 4. bar layout
    try:
        with open(os.path.expanduser("~/.config/omarchy/shell.json")) as f:
            layout = json.load(f).get("bar", {}).get("layout", {})
        placed = any(PLUGIN_ID == w.get("id")
                     for sec in layout.values() for w in sec)
    except (OSError, ValueError, AttributeError):
        placed = False
    add(placed, "Widget placed in the bar", "",
        "omarchy plugin enable " + PLUGIN_ID + " --section right")

    width = max(len(c[1]) for c in checks)
    failed = 0
    for ok, label, detail, fix in checks:
        mark = "ok  " if ok else "FAIL"
        line = f"  [{mark}] {label.ljust(width)}"
        if detail:
            line += f"  {detail}"
        print(line)
        if not ok and fix:
            print(f"         -> {fix}")
        failed += 0 if ok else 1
    print()
    if failed:
        print(f"  {failed} check(s) failed.")
    else:
        print("  All checks passed. If the widget is still missing, give it "
              "5s to poll, then: omarchy restart shell")
    return 1 if failed else 0


def _fmt_time(ts):
    if not ts:
        return "-"
    return time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(ts))


def _fmt_size(n):
    if n is None:
        return ""
    for unit in ("B", "kB", "MB", "GB", "TB"):
        if n < 1000 or unit == "TB":
            return f"{n:.0f} {unit}" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1000
    return f"{n:.1f} TB"


def _print_get(st):
    c = st["connection"]
    print(f"  state        {st['state']}"
          + (f"  (paused since {_fmt_time(st['paused_since'])})" if st["paused"] else ""))
    print(f"  client       {st['version'] or '-'}  daemon={'up' if st['daemon_running'] else 'down'}"
          f"  ui={'up' if st['ui_running'] else 'down'}"
          + (f"  tray says '{st['tray_status']}'" if st.get('tray_status') else ""))
    if c:
        print(f"  nas          {c['user']}@{c['server']}:{c['port']}"
              f"{' (ssl)' if c['ssl'] else ''}  status={c['status']} error={c['error']}")
    for s in st["sessions"]:
        print(f"  folder       {s['name']:<18} {s['folder']:<28} {s['state']}"
              + (f"  {s['pending']} pending" if s["pending"] else ""))
    if st["current"]:
        cur = st["current"]
        print(f"  now          {cur['direction']} {cur['path']} ({_fmt_size(cur['size'])})")
    if st["pending"]:
        print(f"  pending      {st['pending']}")
    if st["recent"]:
        print("  recent")
        for r in st["recent"]:
            print(f"    {_fmt_time(r['time'])}  {r['action']:<10} {r['path']}")
    if st["unsynced"]:
        print(f"  problems     {st['unsynced_count']}")
        for r in st["unsynced"]:
            print(f"    {_fmt_time(r['time'])}  {r['reason']:<22} {r['path']}")
    if st["skipped_count"]:
        print(f"  skipped      {st['skipped_count']} excluded by filter")


def _on_alarm(signum, _frame):
    """The backstop must still take our children with us.

    SIGALRM's default action terminates the process immediately, which
    bypasses the atexit reaper and leaves any helper we started running.
    """
    rt.reap_all()
    os._exit(1)


def main():
    # Own every child on every exit path, including the backstop below.
    rt.install_teardown()
    signal.signal(signal.SIGALRM, _on_alarm)
    # Hard backstop: no invocation may outlive this, whatever wedges. The
    # widget's own deadline is shorter; this catches everything else.
    signal.alarm(SELF_DEADLINE)
    # SUPPRESS matters: without it the subparser re-declares these flags with
    # their own defaults and clobbers the top-level values, so `--json` only
    # works on one side of the subcommand.
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--json", action="store_true", default=argparse.SUPPRESS,
                        help="machine-readable output")

    ap = argparse.ArgumentParser(prog="syndctl", parents=[common],
                                 description=__doc__.split("\n\n")[1])
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("get", parents=[common])
    p = sub.add_parser("log", parents=[common])
    p.add_argument("-n", type=int, default=40)
    p.add_argument("--offset", type=int, default=0)
    p = sub.add_parser("unsynced", parents=[common])
    p.add_argument("-n", type=int, default=20)
    sub.add_parser("settings", parents=[common])
    p = sub.add_parser("pause", parents=[common])
    p.add_argument("session", nargs="*", type=int)
    p = sub.add_parser("resume", parents=[common])
    p.add_argument("session", nargs="*", type=int)
    p = sub.add_parser("ipc", parents=[common])
    p.add_argument("ipc_action")
    p.add_argument("field", nargs="*", help="key=value; value parsed as JSON when it is one")
    sub.add_parser("show", parents=[common])
    p = sub.add_parser("open", parents=[common])
    p.add_argument("session", nargs="?", type=int)
    p = sub.add_parser("reveal", parents=[common])
    p.add_argument("path")
    sub.add_parser("doctor", parents=[common])

    args = ap.parse_args()
    as_json = getattr(args, "json", False)

    if args.cmd == "doctor":
        return doctor()

    with Client() as cl:
        if not cl.conf:
            raise SystemExit("syndctl: Synology Drive Client is not installed (no " + CLIENT_CONF + ")")
        if args.cmd == "get":
            st = cl.get()
            if as_json:
                print(json.dumps(st))
            else:
                _print_get(st)
            return 0
        if args.cmd == "log":
            rows = recent(cl.conf, limit=args.n, offset=args.offset)
            if as_json:
                print(json.dumps(rows))
            else:
                for r in rows:
                    print(f"  {_fmt_time(r['time'])}  {r['action']:<10} {r['path']}")
            return 0
        if args.cmd == "unsynced":
            rows, skipped = unsynced(cl.conf, limit=args.n)
            if as_json:
                print(json.dumps({"unsynced": rows, "skipped_count": skipped}))
            else:
                for r in rows:
                    print(f"  {_fmt_time(r['time'])}  {r['reason']:<22} {r['path']}")
                print(f"  ({skipped} excluded by the client's filter)")
            return 0
        if args.cmd == "show":
            cl.show()
            return 0
        if args.cmd == "settings":
            st = settings(cl.conf)
            if as_json:
                print(json.dumps(st))
            else:
                for k, v in st["global"].items():
                    print(f"  {k:<24} {'-' if v is None else v}")
                for t in st["tasks"]:
                    f = t["filters"]
                    print(f"  task {t['id']}  {t['name']:<18} {t['folder']}  {t['direction']}"
                          f"{'  read-only' if t['read_only'] else ''}")
                    print(f"      excluded: ext {','.join(f['excluded_extensions']) or '-'}"
                          f" | prefix {','.join(f['excluded_name_prefixes']) or '-'}"
                          f" | folders {','.join(f['excluded_folders']) or '-'}")
            return 0
        if args.cmd in ("pause", "resume"):
            r = cl.pause(args.session) if args.cmd == "pause" else cl.resume(args.session)
            if as_json:
                print(json.dumps(r))
            else:
                what = "all tasks" if not args.session else "task " + ", ".join(map(str, r["sessions"]))
                print(f"  {args.cmd}d {what}" if r["confirmed"]
                      else f"  {args.cmd} sent for {what} (daemon has not logged it yet)")
            return 0
        if args.cmd == "ipc":
            fields = {}
            for f in args.field:
                if "=" not in f:
                    raise SystemExit(f"syndctl: expected key=value, got {f!r}")
                k, v = f.split("=", 1)
                try:
                    fields[k] = json.loads(v)
                except json.JSONDecodeError:
                    fields[k] = v
            print(json.dumps(cl.ipc(args.ipc_action, fields), default=repr))
            return 0
        if args.cmd == "reveal":
            cl.reveal(args.path)
            return 0
        if args.cmd == "open":
            folder = cl.open(args.session)
            if as_json:
                print(json.dumps({"opened": folder}))
            else:
                print(f"  opened {folder}")
            return 0
    return 0


if __name__ == "__main__":
    sys.exit(main())
