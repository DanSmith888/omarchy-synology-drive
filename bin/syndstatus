#!/usr/bin/env python3
"""syndstatus — one JSON line describing the Synology Drive Client's state.

    {"present": true, "state": "syncing", "pending": 3, "sessions": [...], ...}

`present` is true whenever the client is installed, even when its daemon is
stopped — a stopped client is worth a pill, an absent one is not. Exits 0
with an empty object when the client is not installed so the widget hides
itself. `state: null` means the client is there but the probe could not
read it this time; the widget keeps its last reading.

All the work is in bin/syndctl; this only decides whether there is anything
to show. Standard library only. No root, no network.
"""

import importlib.machinery
import importlib.util
import json
import os
import re
import signal
import sys

HERE = os.path.dirname(os.path.abspath(__file__))

# Importing a sibling would otherwise litter the plugin folder with
# __pycache__; the plugin dir stays exactly as installed.
sys.dont_write_bytecode = True


def _runtime():
    """Load bin/plugin_runtime.py by path, not by sys.path search.

    An entry earlier on sys.path could otherwise shadow the module name.
    """
    path = os.path.join(HERE, "plugin_runtime.py")
    loader = importlib.machinery.SourceFileLoader("plugin_runtime", path)
    spec = importlib.util.spec_from_loader("plugin_runtime", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


rt = _runtime()
CLIENT_CONF = os.path.expanduser("~/.SynologyDrive/data/config/client.conf")
TIMEOUT = 10


# Ceiling on what any one command may hand back.
MAX_OUTPUT = 262144

# Strings that reach the UI come from other programs: bluetoothctl decorates
# its output with ANSI escapes, and a filename is whatever someone called a
# file. Strip escape sequences and control characters and cap the length, so
# nothing can carry terminal control codes or unbounded text into a panel.
_ANSI = re.compile(r"\x1b\[[0-9;?]*[ -/]*[@-~]")
_CTRL = re.compile(r"[\x00-\x1f\x7f]")
TEXT_MAX = 200


def safe_text(value, limit=TEXT_MAX):
    if value is None:
        return None
    out = _CTRL.sub("", _ANSI.sub("", str(value)))
    return out[:limit].strip()



def scrub(value):
    """Sanitise every string in a payload, however deeply nested.

    Applied once at the boundary rather than at each field, so a new field
    added later cannot quietly skip it.
    """
    if isinstance(value, str):
        return safe_text(value)
    if isinstance(value, list):
        return [scrub(v) for v in value]
    if isinstance(value, dict):
        return {k: scrub(v) for k, v in value.items()}
    return value


def run(cmd, timeout=TIMEOUT, limit=MAX_OUTPUT):
    """stdout on success, None on any failure. Never raises, never hangs.

    Delegates to plugin_runtime, which caps each stream while reading,
    enforces the deadline during the read rather than only around exit, and
    reaps the child's whole process group. Killing the direct child is not
    enough here: syndctl spawns helpers of its own, and those share its group
    and outlive it, so a cancelled poll used to leave work running.
    """
    rc, out, _ = rt.run_bounded(cmd, timeout=timeout, max_output=limit)
    return out or None


def _on_alarm(signum, _frame):
    """The backstop must still take our children with us.

    SIGALRM's default action terminates the process immediately, which
    bypasses the atexit reaper and orphans anything still running.
    """
    rt.reap_all()
    print("{}", flush=True)
    os._exit(0)


def main():
    # Own every child on every exit path, including the backstop below.
    rt.install_teardown()
    signal.signal(signal.SIGALRM, _on_alarm)
    # Hard backstop: this probe may never outlive the widget's deadline.
    signal.alarm(28)
    if not os.path.isfile(CLIENT_CONF):
        print("{}")
        return

    state = {"present": True, "state": None}
    # Run through the trusted interpreter rather than exec'ing the script
    # directly: cmd[0] is resolved against root-owned system directories and
    # the exec is bound to that descriptor.
    out = run(["python3", os.path.join(HERE, "syndctl"), "get", "--json"])
    if out:
        try:
            d = json.loads(out)
            if isinstance(d, dict):
                state.update(d)
        except json.JSONDecodeError:
            pass
    print(json.dumps(scrub(state)))


if __name__ == "__main__":
    main()
